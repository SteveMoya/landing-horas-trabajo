---
import '../styles/global.css';
import '@fontsource-variable/inter';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Horas Trabajo · Registra tus horas y salario según la Ley 16-92 (RD)',
  description = site.description,
  image = `${site.url}/og.png`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Horas Trabajo',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Android',
  description: site.description,
  url: site.url,
  author: { '@type': 'Person', name: 'Steve Moya' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'DOP' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1565c0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#inicio"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>import '../scripts/header.ts';</script>
    <script>import '../scripts/reveal.ts';</script>
  </body>
</html>