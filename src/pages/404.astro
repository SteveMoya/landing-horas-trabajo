---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/brand/Logo.astro';
---

<BaseLayout title="Página no encontrada · Horas Trabajo">
  <div class="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center">
    <Logo size={72} />
    <h1 class="mt-8 font-display text-5xl font-extrabold text-ink-900">404</h1>
    <p class="mt-4 max-w-md text-lg text-slate-600">
      Esta página no existe o se movió de lugar.
    </p>
    <Button href="/" variant="primary" size="lg" class="mt-8">
      Volver al inicio
    </Button>
  </div>
</BaseLayout>