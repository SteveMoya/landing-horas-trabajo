---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'gold' | 'ghost';
  size?: 'md' | 'lg';
  download?: string;
  target?: string;
  class?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  download,
  target,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-pill font-semibold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2';
const sizes = {
  md: 'px-5 py-3 text-sm',
  lg: 'px-7 py-4 text-base',
};
const variants: Record<string, string> = {
  primary:
    'bg-brand-600 text-white shadow-soft hover:bg-brand-700 hover:-translate-y-0.5',
  gold:
    'bg-gold-400 text-ink-900 shadow-soft hover:bg-gold-500 hover:-translate-y-0.5',
  outline:
    'border border-brand-200 bg-white text-brand-700 hover:border-brand-400 hover:bg-brand-50',
  ghost: 'text-brand-700 hover:bg-brand-50',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} {download} {target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
      <slot />
    </a>
  ) : (
    <button type="button" class={cls}>
      <slot />
    </button>
  )
}