---
// Recrea la pantalla "Marcar" de la app (Material 3) como soporte visual del hero.
const hora = '08:45';
const fecha = 'martes, 2 de septiembre';
---

<div class="relative w-[272px] select-none sm:w-[300px]">
  <!-- Marco del teléfono -->
  <div class="relative rounded-[3rem] border border-slate-200 bg-ink-800 p-2.5 shadow-lift">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-brand-50">
      <!-- Dynamic island -->
      <div class="absolute left-1/2 top-2 z-20 h-6 w-24 -translate-x-1/2 rounded-full bg-ink-900" aria-hidden="true"></div>

      <!-- Pantalla de la app -->
      <div class="px-5 pb-6 pt-14">
        <!-- Hora / fecha -->
        <div class="flex items-center justify-between text-[10px] font-medium text-slate-500">
          <span>{fecha}</span>
          <span class="inline-flex items-center gap-1 text-brand-600">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8"/></svg> GPS
          </span>
        </div>

        <!-- Reloj -->
        <div class="mt-5 text-center">
          <div class="font-display text-[56px] font-extrabold leading-none tracking-tight text-ink-900 tabular-nums">
            {hora}
          </div>
          <div class="mt-1 text-xs font-medium text-slate-500">Jornada de hoy · 02:15</div>
        </div>

        <!-- Botón marcar -->
        <div class="mt-6 rounded-2xl bg-brand-600 p-0.5 shadow-soft">
          <div class="flex items-center justify-center gap-2 rounded-[14px] bg-brand-600 py-3.5 text-sm font-semibold text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z"/>
            </svg>
            Marcar entrada
          </div>
        </div>

        <!-- Geocerca -->
        <div class="mt-3 flex items-center gap-2.5 rounded-2xl border border-brand-100 bg-white p-3 shadow-soft">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-[11px] font-semibold text-ink-900">Dentro del área de trabajo</div>
            <div class="text-[10px] text-slate-500">Vigilando llegada y salida · 30 s</div>
          </div>
          <div class="ml-auto h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></div>
        </div>

        <!-- Filas de salario -->
        <div class="mt-3 grid grid-cols-3 gap-2">
          <div class="rounded-xl bg-white p-2 text-center shadow-soft">
            <div class="text-[10px] text-slate-500">Ordinarias</div>
            <div class="text-sm font-extrabold text-ink-900 tabular-nums">6:00</div>
          </div>
          <div class="rounded-xl bg-white p-2 text-center shadow-soft">
            <div class="text-[10px] text-slate-500">Extras</div>
            <div class="text-sm font-extrabold text-brand-600 tabular-nums">1:30</div>
          </div>
          <div class="rounded-xl bg-white p-2 text-center shadow-soft">
            <div class="text-[10px] text-slate-500">Hoy</div>
            <div class="text-sm font-extrabold text-gold-500 tabular-nums">RD$1.245</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Insignia flotante: aviso de llegada -->
  <div class="absolute -right-8 top-24 hidden w-52 -rotate-3 rounded-2xl border border-slate-100 bg-white/95 p-3 shadow-lift backdrop-blur sm:block" data-reveal>
    <div class="flex items-start gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-brand-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>
        </svg>
      </div>
      <div class="text-[11px] leading-snug">
        <div class="font-semibold text-ink-900">¿Marcar la entrada?</div>
        <div class="text-slate-500">Has llegado al trabajo</div>
      </div>
    </div>
  </div>

  <!-- Insignia flotante: salario -->
  <div class="absolute -left-10 bottom-16 hidden rotate-3 rounded-2xl border border-slate-100 bg-white/95 p-3 shadow-lift backdrop-blur sm:block" data-reveal>
    <div class="text-[10px] text-slate-500">Total esta semana</div>
    <div class="flex items-end gap-1.5">
      <span class="font-display text-lg font-extrabold text-brand-700 tabular-nums">RD$22.480</span>
    </div>
    <div class="mt-0.5 inline-flex items-center gap-1 rounded-full bg-gold-300/30 px-2 py-0.5 text-[10px] font-semibold text-gold-500">
      +35% extras
    </div>
  </div>
</div>