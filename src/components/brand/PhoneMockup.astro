---
// Muestra una captura real de la app (pantalla "Marcar") dentro del teléfono,
// con efecto 3D de seguimiento del mouse (data-tilt).
---

<div
  class="relative w-[272px] select-none sm:w-[300px]"
  style="perspective: 1200px"
  data-tilt
>
  <!-- Marco del teléfono -->
  <div class="relative rounded-[3rem] border border-slate-200 bg-ink-800 p-2.5 shadow-lift" style="transform-style: preserve-3d">
    <div class="relative overflow-hidden rounded-[2.5rem] bg-ink-900" style="transform-style: preserve-3d">
      <!-- Dynamic island -->
      <div class="absolute left-1/2 top-2 z-30 h-6 w-24 -translate-x-1/2 rounded-full bg-ink-950" aria-hidden="true"></div>

      <!-- Captura real de la aplicación -->
      <img
        src="/screens/home.png"
        alt="Captura de la pantalla Marcar de la aplicación Horas Trabajo"
        width="390"
        height="844"
        fetchpriority="high"
        class="aspect-[390/844] w-full object-cover object-top"
      />

      <!-- Brillo sutil -->
      <div class="pointer-events-none absolute inset-0 rounded-[2.5rem] ring-1 ring-inset ring-white/10" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(115deg,rgba(255,255,255,.14)_0%,transparent_35%)]" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Insignia flotante: aviso de llegada -->
  <div class="absolute -right-8 top-24 hidden w-52 -rotate-3 rounded-2xl border border-slate-100 bg-white/95 p-3 shadow-lift backdrop-blur sm:block" data-reveal>
    <div class="flex items-start gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-brand-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>
        </svg>
      </div>
      <div class="text-[11px] leading-snug">
        <div class="font-semibold text-ink-900">¿Marcar la entrada?</div>
        <div class="text-slate-500">Has llegado al trabajo</div>
      </div>
    </div>
  </div>

  <!-- Insignia flotante: salario -->
  <div class="absolute -left-10 bottom-16 hidden rotate-3 rounded-2xl border border-slate-100 bg-white/95 p-3 shadow-lift backdrop-blur sm:block" data-reveal>
    <div class="text-[10px] text-slate-500">Total esta semana</div>
    <div class="flex items-end gap-1.5">
      <span class="font-display text-lg font-extrabold text-brand-700 tabular-nums">RD$22.480</span>
    </div>
    <div class="mt-0.5 inline-flex items-center gap-1 rounded-full bg-gold-300/30 px-2 py-0.5 text-[10px] font-semibold text-gold-500">
      +35% extras
    </div>
  </div>
</div>