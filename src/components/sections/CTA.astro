---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { site } from '@/data/site';
---

<section id="descarga" class="relative overflow-hidden bg-ink-800 py-24 text-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-20 top-0 h-80 w-80 rounded-full bg-brand-600/40 blur-3xl"></div>
    <div class="absolute right-0 bottom-0 h-80 w-80 rounded-full bg-accent-500/30 blur-3xl"></div>
  </div>

  <Container class="relative text-center">
    <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-slate-200 ring-1 ring-white/15" data-reveal>
      Beta · Android
    </span>
    <h2 class="mx-auto mt-5 max-w-2xl font-display text-3xl font-extrabold tracking-tight sm:text-4xl" data-reveal>
      Empieza hoy a registrar tus horas
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300" data-reveal>
      Descarga la Beta, guarda tu lugar de trabajo y deja que Horas Trabajo calcule tu salario según la Ley 16-92.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3.5" data-reveal>
      <Button href={site.apkUrl} variant="gold" size="lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" />
        </svg>
        Descargar APK (Beta)
      </Button>
      <Button href={site.githubRepo} variant="ghost" size="lg" target="_blank" class="!text-white hover:!bg-white/10">
        Ver código en GitHub
      </Button>
    </div>

    <p class="mt-6 text-xs text-slate-400">
      Instala permitiendo "fuentes desconocidas" en Android. Es una versión Beta en evolución.
    </p>
  </Container>
</section>