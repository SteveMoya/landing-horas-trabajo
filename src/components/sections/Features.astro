---
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import { features, type Feature } from '@/data/features';

const icons: Record<Feature['icon'], string> = {
  marca:
    '<circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/>',
  geocerca:
    '<path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  aviso:
    '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>',
  salario:
    '<rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M9 7h6m-6 4h6m-6 4h3"/>',
  reporte:
    '<path d="M4 20V10m5 10V4m5 16v-8m5 8V8"/>',
  local:
    '<path d="M12 3 5 6v5c0 5 3.5 8.5 7 10 3.5-1.5 7-5 7-10V6l-7-3Z"/><path d="M12 10v4m0 0h.01"/>',
};
function iconSvg(name: Feature['icon']) {
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
}
---

<section id="caracteristicas" class="bg-white py-24">
  <Container>
    <Section
      eyebrow="Funcionalidades"
      title="Todo lo que necesitas para llevar tus horas al día"
      subtitle="Del marcado con GPS al cálculo salarial según la normativa laboral de República Dominicana, sin salir de tu teléfono."
    />

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <article
          class="group relative overflow-hidden rounded-card border border-slate-100 bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift"
          data-reveal
          style={`animation-delay:${(i % 3) * 0.08}s`}
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white" set:html={iconSvg(f.icon)}></div>
          <h3 class="mt-5 text-lg font-bold text-ink-900">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.text}</p>
        </article>
      ))}
    </div>
  </Container>
</section>