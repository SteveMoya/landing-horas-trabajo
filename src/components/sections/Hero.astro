---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import PhoneMockup from '@/components/brand/PhoneMockup.astro';
import { site } from '@/data/site';
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Fondo: blobs radiales -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-brand-100/70 blur-3xl"></div>
    <div class="absolute top-20 right-0 h-[28rem] w-[28rem] rounded-full bg-accent-400/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-gold-300/20 blur-3xl"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,white_0%,white_40%,transparent_100%)]"></div>
  </div>

  <Container class="relative grid items-center gap-12 pb-20 pt-28 sm:pt-32 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:pt-36">
    <div class="animate-rise">
      <Badge tone="blue" class="mb-5">
        <span class="inline-flex items-center gap-2">
          Beta · República Dominicana · Ley 16-92
        </span>
      </Badge>

      <h1 class="font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl lg:text-[3.4rem]">
        Registra tus horas y cobra
        <span class="relative whitespace-nowrap text-brand-600">
          según la ley
          <svg class="absolute -bottom-2 left-0 w-full" height="10" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 8 C 60 2 140 2 198 7" stroke="var(--color-gold-400)" stroke-width="4" fill="none" stroke-linecap="round"/>
          </svg>
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
        {site.tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <Button href={site.apkUrl} size="lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" />
          </svg>
          Descargar APK (Beta)
        </Button>
        <Button href="#caracteristicas" variant="outline" size="lg">
          Ver características
        </Button>
      </div>

      <div class="mt-8 flex flex-col gap-3 text-sm text-slate-500 sm:flex-row sm:items-center sm:gap-6">
        <span class="inline-flex items-center gap-2">
          <svg class="text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          100% en tu dispositivo
        </span>
        <span class="inline-flex items-center gap-2">
          <svg class="text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          Sin cuentas ni nube
        </span>
        <span class="inline-flex items-center gap-2">
          <svg class="text-emerald-500" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
          Avisos al llegar y salir
        </span>
      </div>
    </div>

    <div class="animate-rise flex justify-center lg:justify-end" style="animation-delay:.12s">
      <PhoneMockup />
    </div>
  </Container>
</section>